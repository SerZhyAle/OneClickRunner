<Window x:Class="OneClickRunner.Windows.AppItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Application"
        Height="440" Width="540"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Each label sits on its own line above its field; fields stretch with the window. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Scenario type:" Margin="0,0,0,3"/>
            <ComboBox Name="TypeComboBox" Margin="0,0,0,12" SelectionChanged="TypeComboBox_SelectionChanged">
                <ComboBoxItem Content="Executable / script"/>
                <ComboBoxItem Content="yt-dlp download"/>
            </ComboBox>

            <TextBlock Text="Name:" Margin="0,0,0,3"/>
            <TextBox Name="NameTextBox" Margin="0,0,0,12"/>

            <!-- Executable / script fields -->
            <StackPanel Name="ExecutablePanel">
                <TextBlock Text="Path to executable or script:" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="PathTextBox" Grid.Column="0"/>
                    <Button Name="BrowseButton" Content="Browse..." Grid.Column="1" Width="80" Margin="6,0,0,0" Click="BrowseButton_Click"/>
                </Grid>

                <TextBlock Text="Arguments (optional):" Margin="0,0,0,3"/>
                <TextBox Name="ArgumentsTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Working Directory (optional):" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="WorkingDirectoryTextBox" Grid.Column="0"/>
                    <Button Name="BrowseWorkingDirButton" Content="Browse..." Grid.Column="1" Width="80" Margin="6,0,0,0" Click="BrowseWorkingDirButton_Click"/>
                </Grid>

                <CheckBox Name="RunAsAdminCheckBox" Content="Run as Administrator" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- yt-dlp download fields -->
            <StackPanel Name="YtDlpPanel" Visibility="Collapsed">
                <TextBlock Text="Download folder (leave empty for Downloads):" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="YtDlpOutputFolderTextBox" Grid.Column="0"/>
                    <Button Name="BrowseOutputButton" Content="Browse..." Grid.Column="1" Width="80" Margin="6,0,0,0" Click="BrowseOutputButton_Click"/>
                </Grid>

                <TextBlock Text="Extra yt-dlp options (optional, e.g. -f bestvideo+bestaudio):" Margin="0,0,0,3"/>
                <TextBox Name="YtDlpFormatTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="You will be asked for the link each time this scenario runs. yt-dlp must be on PATH."
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="OkButton" Content="OK" Width="80" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Name="CancelButton" Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
