<Window x:Class="OneClickRunner.Windows.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneClickRunner"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown">
    <Border Background="#2D2D30" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="4" Background="#E81123" CornerRadius="2" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Foreground="#D0D0D0" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="click to dismiss" Foreground="#7A7A7A" FontSize="10" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
