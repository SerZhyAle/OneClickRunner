<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Keys are shared with DarkColors.xaml so the theme can be swapped live. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
</ResourceDictionary>
