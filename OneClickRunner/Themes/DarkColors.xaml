<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Same keys as LightColors.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#333337"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#333337"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E9CFF"/>
</ResourceDictionary>
